{
  "name": "@local/dsh-api-testbench",
  "version": "0.2.1",
  "private": true,
  "description": "TestRelay for DeepSeek Harness: watch an agent test HTTP APIs, replay a request, and send the comparison back to chat.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JavaLyHn/dsh-testrelay.git"
  },
  "homepage": "https://github.com/JavaLyHn/dsh-testrelay",
  "bugs": {
    "url": "https://github.com/JavaLyHn/dsh-testrelay/issues"
  },
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./remote": "./remote.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "remote.js",
    "host/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "fixtures/**/*.mjs",
    "tests/**/*.mjs",
    "README.md",
    "VERIFICATION.md"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-tool"
      ],
      "external": [
        "zod"
      ]
    }
  }
}
